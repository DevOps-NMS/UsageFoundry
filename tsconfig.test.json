{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "isolatedModules": false
  },
  "include": ["src/lib/**/*.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
